# This repo had NO .gitignore at all until 29 July 2026, so .env, node_modules
# and dist were all committable. Patterns must NOT be quoted — the command-centre
# repo had "server/.env" with literal quote marks, which matched nothing.

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
