# ==============================================================================
# DEEPFLOWAI TRADES MARKETING SITE — CONFIGURATION
#
# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# build context (.dockerignore) — it must never be committed.
#
#   cp .env.example .env
#
# ── The one rule that matters ────────────────────────────────────────────────
# Anything named VITE_* is compiled INTO the browser bundle and is PUBLIC.
# Every visitor can read it with View Source. Never put a key, token, password
# or private URL behind a VITE_ prefix.
#
# Everything without the prefix is read by the server at runtime and never
# reaches the browser. Secrets go there — and only there.
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
# PUBLIC — compiled into the bundle at build time (safe to be seen)
# ══════════════════════════════════════════════════════════════════════════════

# Where the enquiry forms POST. This is a public endpoint the browser calls
# directly, so it is fine here.
#
# Because it is baked in at BUILD time, changing it requires a rebuild:
#   docker compose -p deepflow up -d --build
#
# Production:  https://admin.deepflowai.co.uk/api/intake
# Local dev:   http://localhost:5000/api/intake
VITE_WEBHOOK_URL=http://localhost:5000/api/intake


# ══════════════════════════════════════════════════════════════════════════════
# SERVER-ONLY — read at runtime, never sent to the browser
# ══════════════════════════════════════════════════════════════════════════════

# Google Gemini key, powering the interactive workflow preview.
#
# Leave BLANK and the site runs perfectly well with that one feature switched
# off — the endpoint returns an honest "not configured" response rather than
# breaking the page. Nothing else depends on it.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for the preview. Flash is fast and cheap, which suits a public
# demo; swap it if you want richer output and can accept the cost.
GEMINI_MODEL=gemini-2.5-flash

# Set to false to switch the preview off even when a key is present.
AI_DEMO_ENABLED=true

# Per-IP cap on preview requests, per hour. This endpoint costs money on every
# call and faces the open internet, so keep it tight.
AI_RATE_LIMIT_MAX=10


# ══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT
# ══════════════════════════════════════════════════════════════════════════════

# Host port Caddy proxies to. Bound to 127.0.0.1 only — never publicly exposed.
# Change it if something else on the VPS already uses 8090.
DEEPFLOW_HOST_PORT=8090


# ══════════════════════════════════════════════════════════════════════════════
# NOT USED BY THIS REPOSITORY
# ══════════════════════════════════════════════════════════════════════════════
# This is a static marketing site. It has no database, no user accounts and no
# authentication of its own. The enquiry pipeline — the projects database, the
# AI documents, the outbound email and the Vapi calls — all live in the separate
# command-centre application behind VITE_WEBHOOK_URL above.
#
# Earlier versions of this file listed VITE_AI_PROVIDER, VITE_OLLAMA_URL and
# VITE_GEMINI_API_KEY. Nothing reads them, and the last of those would have
# published a key to every visitor. They have been removed rather than left to
# mislead.
