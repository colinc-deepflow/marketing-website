# ============================================
# DEEPFLOWAI MARKETING WEBSITE - CONFIGURATION
# ============================================

# Webhook URL - Where form submissions are sent
VITE_WEBHOOK_URL=http://localhost:5000/api/intake

# ============================================
# AI PROVIDER FOR INTERACTIVE DEMO
# ============================================
# Options: "ollama" (local), "gemini" (cloud)
VITE_AI_PROVIDER=ollama
VITE_OLLAMA_URL=http://localhost:11434

# To disable the AI demo entirely:
# VITE_DISABLE_AI_DEMO=true

# CLOUD AI (Optional - only if using Gemini for demo)
# VITE_GEMINI_API_KEY=AIza...
