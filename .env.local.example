# DeepflowAI Marketing Website - Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# GOOGLE GEMINI API (For interactive demo on website)
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# WEBHOOK URL (Where form submissions are sent)
# ============================================
# Points to the DeepflowAI webhook server
VITE_WEBHOOK_URL=http://localhost:5000/api/intake
